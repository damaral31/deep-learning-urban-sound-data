    "# Importar funções de augmentation do módulo\n",
    "import sys\n",
    "sys.path.append(str(config.PROJECT_ROOT))\n",
    "\n",
    "from augmentation import add_white_noise, butter_bandpass_filter\n",
    "import librosa\n",
    "import librosa.display\n",
    "import IPython.display as ipd\n",
    "\n",
    "# Selecionar um áudio de exemplo (classe gun_shot para ter um som distintivo)\n",
    "clip_id = list(dl.all_clips.keys())[100]  # Pegar um exemplo qualquer\n",
    "clip = dl.all_clips[clip_id]\n",
    "audio_original, sr = clip.audio\n",
    "\n",
    "print(f\"Exemplo selecionado: {clip.class_label} (ID: {clip_id})\")\n",
    "print(f\"Sample Rate: {sr} Hz\")\n",
    "print(f\"Duração: {len(audio_original)/sr:.2f} segundos\")\n",
    "\n",
    "# Aplicar as augmentações\n",
    "audio_white_noise = add_white_noise(audio_original, noise_factor=0.005)\n",
    "audio_bandpass = butter_bandpass_filter(audio_original, sr, lowcut=300, highcut=3000)\n",
    "audio_extra_noise = add_white_noise(audio_original, noise_factor=0.003)\n",
    "\n",
    "# Preparar para visualização\n",
    "audios = [\n",
    "    (\"Original\", audio_original),\n",
    "    (\"White Noise\", audio_white_noise),\n",
    "    (\"Bandpass Filter\", audio_bandpass),\n",
    "    (\"Extra Noise\", audio_extra_noise)\n",
    "]\n",
    "\n",
    "# Criar visualização\n",
    "fig, axes = plt.subplots(4, 3, figsize=(18, 16))\n",
    "fig.suptitle(f'Comparação de Augmentações - {clip.class_label}', fontsize=16)\n",
    "\n",
    "for idx, (title, audio) in enumerate(audios):\n",
    "    # Waveform\n",
    "    ax1 = axes[idx, 0]\n",
    "    librosa.display.waveshow(audio, sr=sr, ax=ax1)\n",
    "    ax1.set_title(f'{title} - Waveform')\n",
    "    ax1.set_xlabel('Tempo (s)')\n",
    "    ax1.set_ylabel('Amplitude')\n",
    "    \n",
    "    # Mel Spectrogram\n",
    "    ax2 = axes[idx, 1]\n",
    "    S = librosa.feature.melspectrogram(y=audio, sr=sr, n_mels=64)\n",
    "    S_dB = librosa.power_to_db(S, ref=np.max)\n",
    "    img = librosa.display.specshow(S_dB, x_axis='time', y_axis='mel', sr=sr, ax=ax2, cmap='viridis')\n",
    "    ax2.set_title(f'{title} - Mel Spectrogram')\n",
    "    fig.colorbar(img, ax=ax2, format='%+2.0f dB')\n",
    "    \n",
    "    # Log-Mel Spectrogram (como usado no preprocessor)\n",
    "    ax3 = axes[idx, 2]\n",
    "    # Processar como no AudioPreprocessor\n",
    "    audio_mono = librosa.to_mono(audio) if audio.ndim > 1 else audio\n",
    "    audio_resampled = librosa.resample(audio_mono, orig_sr=sr, target_sr=22050)\n",
    "    # Extrair log-mel\n",
    "    mel_spec = librosa.feature.melspectrogram(y=audio_resampled, sr=22050, n_mels=64, n_fft=2048, hop_length=512)\n",
    "    log_mel = librosa.power_to_db(mel_spec, ref=np.max)\n",
    "    img2 = librosa.display.specshow(log_mel, x_axis='time', y_axis='mel', sr=22050, ax=ax3, cmap='viridis')\n",
    "    ax3.set_title(f'{title} - Log-Mel (preprocessed)')\n",
    "    fig.colorbar(img2, ax=ax3, format='%+2.0f dB')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Preview de áudio para cada augmentação\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"PREVIEW DE ÁUDIO\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "for title, audio in audios:\n",
    "    print(f\"\\n{title}:\")\n",
    "    display(ipd.Audio(audio, rate=sr))"
   ]
  },
